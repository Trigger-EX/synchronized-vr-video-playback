#!/usr/bin/env bash
# Fake adb for tests. Appends its argv (one line per call) to $FAKE_ADB_LOG.
#   FAKE_ADB_DEVICES  file that `adb devices` prints (default: ../fixtures/adb_devices.txt)
#   FAKE_ADB_FAIL     space-separated serials whose commands exit 1 ("error: device offline")
#   FAKE_ADB_STATE    directory for per-serial wakefulness files (see below); FAKE_ADB_WAKEFULNESS default state
#   FAKE_ADB_STUCK    serials whose screen ignores keyevents 223/224
#   FAKE_ADB_FAIL_CMD space-separated substrings; a command whose argv contains one exits 1 (partial failure)
#   FAKE_ADB_SLEEP_CMD substring of a command that sleeps $FAKE_ADB_SLEEP_CMD_S seconds (per-command timeout)
#   FAKE_ADB_WINDOW   window fixture stem (default window); FAKE_ADB_LOGCAT file for `logcat -d -T` and `logcat -d -t N`
#   FAKE_ADB_CONNECT_FAIL addresses whose `adb connect` prints failed (exit 0, like real adb)
#   FAKE_ADB_DISCONNECT_FAIL addresses whose `adb disconnect` prints an error (exit 0, like real adb)
#   FAKE_ADB_SLEEP    seconds every non-`devices` command takes (to exercise timeouts)
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
[ -n "$FAKE_ADB_LOG" ] && printf '%s\n' "$*" >> "$FAKE_ADB_LOG"
serial=""
if [ "$1" = "-s" ]; then serial="$2"; shift 2; fi
if [ "$1" = "devices" ]; then
  cat "${FAKE_ADB_DEVICES:-$here/../fixtures/adb_devices.txt}"
  exit 0
fi
if [ "$1" = "connect" ]; then
  case " $FAKE_ADB_CONNECT_FAIL " in *" $2 "*) echo "failed to connect to '$2'"; exit 0;; esac
  echo "connected to $2"; exit 0
fi
if [ "$1" = "disconnect" ]; then
  case " $FAKE_ADB_DISCONNECT_FAIL " in *" $2 "*) echo "error: no such device '$2'"; exit 0;; esac
  echo "disconnected $2"; exit 0
fi
[ -n "$FAKE_ADB_SLEEP" ] && sleep "$FAKE_ADB_SLEEP"
# Wakefulness: per-serial file in $FAKE_ADB_STATE (a directory) holding Awake or Asleep; default
# $FAKE_ADB_WAKEFULNESS or Awake. `input keyevent 223/224` flips it unless $FAKE_ADB_STUCK lists the serial.
state_file=""
[ -n "$FAKE_ADB_STATE" ] && state_file="$FAKE_ADB_STATE/wake_${serial//[^A-Za-z0-9._-]/_}"
wakefulness() { if [ -n "$state_file" ] && [ -f "$state_file" ]; then cat "$state_file"; else echo "${FAKE_ADB_WAKEFULNESS:-Awake}"; fi; }
for bad in $FAKE_ADB_FAIL; do
  if [ "$bad" = "$serial" ]; then echo "error: device offline" >&2; exit 1; fi
done
for bad in $FAKE_ADB_FAIL_CMD; do
  case "$*" in *"$bad"*) echo "error: $bad failed" >&2; exit 1;; esac
done
if [ -n "$FAKE_ADB_SLEEP_CMD" ]; then
  case "$*" in *"$FAKE_ADB_SLEEP_CMD"*) sleep "${FAKE_ADB_SLEEP_CMD_S:-5}";; esac
fi
fx="$here/../fixtures/dumpsys"
if [ "$1" = "exec-out" ] && [ "$2" = "screencap" ]; then cat "$fx/screencap.png"; exit 0; fi
if [ "$1" = "shell" ]; then
  case "$2" in
    "dumpsys display"*) cat "$fx/${FAKE_ADB_DISPLAY:-display}.txt"; exit 0;;
    "dumpsys window windows"*) cat "$fx/${FAKE_ADB_WINDOW:-window}.txt"; exit 0;;
    "dumpsys activity activities"*) cat "$fx/activities.txt"; exit 0;;
    "dumpsys audio"*) cat "$fx/audio.txt"; exit 0;;
    "dumpsys SurfaceFlinger --list"*) cat "$fx/surfaceflinger_list.txt"; exit 0;;
    "dumpsys SurfaceFlinger"*) cat "$fx/surfaceflinger.txt"; exit 0;;
    "dumpsys thermalservice"*) cat "$fx/thermal.txt"; exit 0;;
    "dumpsys battery"*) cat "$fx/battery.txt"; exit 0;;
    "logcat -d -T"*|"logcat -d -t"*) cat "${FAKE_ADB_LOGCAT:-$fx/logcat.txt}"; exit 0;;
    "getprop"*) cat "$fx/getprop.txt"; exit 0;;
    "dumpsys power"*)
      fixture="$here/../fixtures/dumpsys/power_$(wakefulness | tr 'A-Z' 'a-z').txt"
      case "$2" in *mWakefulness*) grep mWakefulness "$fixture";; *) cat "$fixture";; esac
      exit 0;;
    "input keyevent 223"|"input keyevent 224")
      stuck=""; for s in $FAKE_ADB_STUCK; do [ "$s" = "$serial" ] && stuck=1; done
      if [ -n "$state_file" ] && [ -z "$stuck" ]; then
        if [ "$2" = "input keyevent 223" ]; then echo Asleep > "$state_file"; else echo Awake > "$state_file"; fi
      fi
      exit 0;;
    "("*)  # a compound command (pipes, grep -v): run it for real over the fixtures
      logcat() { cat "${FAKE_ADB_LOGCAT:-$fx/logcat.txt}"; }
      dumpsys() { cat "$fx/${FAKE_ADB_WINDOW:-window}.txt"; }
      eval "$2"; exit $?;;
  esac
fi
echo "fake ok ${serial}: $*"
